# Copy to .env.local for local development.
# Server-only variables must not use the NEXT_PUBLIC_ prefix.

# ---------------------------------------------------------------------------
# Local / Preview / Production
# Use separate DATABASE_URL and NEXT_PUBLIC_SITE_URL values per environment.
# Do not reuse production credentials in local development.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL=

# Public site URL for metadata, sitemap, robots, and absolute links
# Local:      http://localhost:3000
# Preview:    https://your-preview-domain.example
# Production: https://your-production-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: attach a client analytics vendor by assigning window.apineerTrack in the browser.
# Apineer emits typed events via trackEvent() and the "apineer-analytics" CustomEvent.

# ---------------------------------------------------------------------------
# Deployment commands (run against the target environment)
# 1. npm run db:migrate
# 2. npm run db:validate-seed
# 3. npm run db:seed            # idempotent; safe to re-run for verification
# 4. npm run prep:production    # full pre-deploy verification pipeline
# ---------------------------------------------------------------------------
