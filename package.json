{
  "name": "apineer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/verify-phase11-integration.ts",
    "test:audit": "tsx scripts/run-phase11-audit.ts",
    "verify:production": "tsx scripts/verify-phase12-production.ts",
    "prep:production": "tsx scripts/run-phase12-prep.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:validate-seed": "tsx src/db/seed/run-validate.ts",
    "db:seed": "tsx src/db/seed/run-seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
